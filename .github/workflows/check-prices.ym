name: Check laptop prices

on:
  schedule:
    - cron: "17 */3 * * *"
  workflow_dispatch: {}
  push:
    paths: ["tracked.json"]

permissions:
  contents: write

concurrency:
  group: price-check
  cancel-in-progress: false

jobs:
  check:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - name: Check prices
        env:
          BESTBUY_API_KEY: ${{ secrets.BESTBUY_API_KEY }}
        run: node scripts/check-prices.mjs
      - name: Save feed.json
        run: |
          if git diff --quiet -- feed.json; then
            echo "No changes."
            exit 0
          fi
          git config user.name  "price-check-bot"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add feed.json
          git commit -m "Price check $(date -u +'%Y-%m-%d %H:%M UTC')"
          git pull --rebase --autostash
          git push
